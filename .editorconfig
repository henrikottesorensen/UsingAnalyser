root = true

[*]
end_of_line = lf
insert_final_newline = true

[*.{cs,csproj,slnx}]
indent_style = space
indent_size = 4

# This repository is subject to its own rule. UsingAnalyser is the solution's own root, so the
# analyser's assemblies count as first party to each other.
[*.cs]
usinglayout.first_party_prefixes = UsingAnalyser

[*.md]
trim_trailing_whitespace = false
